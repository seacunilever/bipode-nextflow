nextflow_process {

    name "Test Process COMPRESS_OUTPUT"
    script "../main.nf"
    process "COMPRESS_OUTPUT"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = [ [id: "Nitrofurantoin_HepG2"], ["${projectDir}/assets/test_data/minimal/BIFROST_input_Nitrofurantoin_HepG2_fits_1.tar.gz"] ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out.compressed_fits_files).match()
        }

    }

}
