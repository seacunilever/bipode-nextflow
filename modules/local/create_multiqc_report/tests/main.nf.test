nextflow_process {

    name "Test Process CREATE_MULTIQC_REPORT"
    script "../main.nf"
    process "CREATE_MULTIQC_REPORT"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                // define inputs of the process here. Example:
                input[0] = [ [id: "Nitrofurantoin_HepG2"], file("${projectDir}/assets/test_data/minimal/Nitrofurantoin_HepG2_results.json"), "HepG2", "Nitrofurantoin" ]
                """
            }
        }

        then {
            def summary_file = file(process.out.data[0]).listFiles().findAll { it.name == "bifrost_summary.txt" }[0]
            println summary_file
            assert process.success
            assert snapshot(summary_file).match()
        }

    }

}
