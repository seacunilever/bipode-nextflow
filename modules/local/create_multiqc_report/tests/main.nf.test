nextflow_process {

    name "Test Process CREATE_MULTIQC_REPORT"
    script "../main.nf"
    process "CREATE_MULTIQC_REPORT"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                // define inputs of the process here. Example:
                input[0] = [ [id: "Nitrofurantoin_HepG2"], file("${projectDir}/assets/test_data/minimal/BIFROST_input_Nitrofurantoin_HepG2_results.json.zip"), "HepG2", "Nitrofurantoin" ]
                """
            }
        }

        then {
            def output_files = file(process.out.data[0]).listFiles().findAll {
                !['multiqc_data.json', 'pod_vs_fc.txt'].contains(it.name)
            }.sort { it.name }
            assert process.success
            assert snapshot(output_files).match()
        }

    }

}
