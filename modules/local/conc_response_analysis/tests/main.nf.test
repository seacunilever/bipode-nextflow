nextflow_process {

    name "Test Process CONC_RESPONSE_ANALYSIS"
    script "modules/local/conc_response_analysis/main.nf"
    process "CONC_RESPONSE_ANALYSIS"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = file("${projectDir}/assets/model/BIFROST_HTTr_beta_logistic_batch.stan")
                input[1] = [['name': 'Nitrofurantoin_HepG2', 'batch_number': 0], ['ACBD3_59', 'CEP89_11010'], file("${projectDir}/assets/test_data/minimal/Nitrofurantoin_HepG2_probes_batch0.tar.gz")]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out.fits_files).match()
        }

    }

}
