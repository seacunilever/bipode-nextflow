nextflow_process {

    name "Test Process COMPILE_STAN_MODEL"
    script "../main.nf"
    process "COMPILE_STAN_MODEL"

    test("Should compile Stan model successfully") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = file("${projectDir}/assets/model/BIFROST_HTTr_beta_logistic_batch.stan")
                """
            }
        }

        then {
            assert process.success
            def compiled_model = file(process.out.compiled_model[0])

            // Test executable permissions (should be executable)
            assert compiled_model.canExecute()

            // Test file naming convention
            assert compiled_model.name == "BIFROST_HTTr_beta_logistic_batch"
        }
    }

}
