/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

params {
    outdir = 'results'
}

// Impose sensible resource limits for testing
process {
    withName: '.*' {
        cpus   = 2
        memory = 3.GB
        time   = 2.h
    }

    withName: 'CONC_RESPONSE_ANALYSIS' {
        ext.args = "--seed 42"

        // Try to make the tar file reproducible for testing, but actually we 
        //don't test the compressed version
        ext.args2 = "--owner=0 --group=0 --numeric-owner"
        ext.args3 = "-n"
    }

    withName: 'COMPRESS_OUTPUT' {
        ext.args = "--seed 42 --no-compression"
    }
}
