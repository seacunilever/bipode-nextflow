/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    // Set container and conda for all processes
    conda = "bipode-httr=0.4.0"
    container = { workflow.containerEngine == 'singularity' ?
        'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/f3/f3fddbc020a7295009575826d86375cd3a78b52a1ed859911022f2b315d723e4/data' :
        'community.wave.seqera.io/library/bipode-httr:0.5.0--aa5af43cbbd98958' }

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'PREPARE_INPUTS' {
        publishDir = [
            enabled: false
        ]

        ext.args = {
            //normalize batch_key to a list of strings
            def keys = []
            if (params.batch_key instanceof List) {
            keys = params.batch_key
            }
            else if (params.batch_key instanceof CharSequence) {
            keys = params.batch_key.toString().split(',')
            }

            //clean up: trim and drop empty
            keys = keys
            .collect { v -> v?.toString()?.trim() }
            .findAll { v -> v }

            //quote when needed
            def q = { String v ->
            if (v == null) return null
            boolean needsQuote = v.contains(' ') || v.contains('\t') || v.contains('"') || v.contains("'")
            if (!needsQuote) return v
            //escape backslashes and double quotes
            return "\"" + v.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
            }

            //build args
            def argsList = []

            keys.each { k ->
            argsList << "--batch-key"
            argsList << q(k)
            }

            if (params.min_percent_mapped_reads != null) {
            argsList << "--min-percent-mapped-reads"
            argsList << params.min_percent_mapped_reads.toString()
            }

            if (params.min_num_mapped_reads != null) {
            argsList << "--min-num-mapped-reads"
            argsList << params.min_num_mapped_reads.toString()
            }

            if (params.min_avg_treatment_count != null) {
            argsList << "--min-avg-treatment-count"
            argsList << params.min_avg_treatment_count.toString()
            }

            // ---- final argument string ----
            argsList.join(' ')
        }
    }

    withName: 'CONC_RESPONSE_ANALYSIS' {
        publishDir = [
            enabled: false
        ]
        ext.prefix = { "${meta.name}_fits_${meta.batch_number}" }
        ext.args = params.seed ? "--seed ${params.seed}" : ''
        // On setups with shared file systems, the module pre-compilation seems
        // to work fine, but for some reason not on e.g. Azure without Fusion.
        // If we choose to compile per process on a shared file system, we need
        // to copy in the uncompiled model to prevent race conditions where the
        // model is compiled by multiple processes.
        stageInMode = { params.precompile_model ? 'symlink' : 'copy' }
    }

    withName: 'COMPRESS_OUTPUT' {
        publishDir = [
            path: { "${params.outdir}/compressed_results" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.prefix = { "${meta.id}_results" }
        ext.args = { params.seed ? "--seed ${params.seed}" : '' }
    }

    withName: 'SPLIT_DATA' {
        publishDir = [
            enabled: false
        ]
        ext.prefix = { "${meta.id}_probes" }
        ext.args = { [
            "--batch-size ${params.n_cores}",
            "--batch-mode ${params.batch_mode}",
            "--test-probes \"${params.test_probes}\"",
            params.seed ? "--random-seed ${params.seed}" : ""
        ].join(' ').trim() }
    }

    withName: 'CREATE_MULTIQC_REPORT' {
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = [
            params.report_timepoint ? "--timepoint \"${params.report_timepoint}\"" : '',
            params.report_conc_units ? "--conc-units \"${params.report_conc_units}\"" : '',
            params.report_interactive_plots ? '--interactive-plots' : '',
            params.report_n_fold_change_probes ? "--n-fold-change-probes \"${params.report_n_fold_change_probes}\"" : '',
            params.report_cds_threshold ? "--cds-threshold \"${params.report_cds_threshold}\"" : '',
            params.report_n_lowest_means ? "--n-lowest-means \"${params.report_n_lowest_means}\"" : '',
            params.report_n_pod_stats ? "--n-pod-stats \"${params.report_n_pod_stats}\"" : '',
            params.report_plot_height ? "--plot-height  \"${params.report_plot_height}\"" : '',
            params.report_pod_vs_fc_height ? "--pod-vs-fc-height \"${params.report_pod_vs_fc_height}\"" : '',
            params.report_no_cds_threshold ? '--no-cds-threshold' : ''
        ].join(' ').trim()
    }

}
