/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run bifrost.nf -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/


params {
    n_cores = 4
    max_nodes = 1

    // Input data
    input = "${projectDir}/assets/test_data/full/Example_Meta_Data.csv"
    counts = "${projectDir}/assets/test_data/full/Example_Counts.csv"
    substances_cell_types = "${projectDir}/assets/test_data/full/substances_cell_types.yml"
}