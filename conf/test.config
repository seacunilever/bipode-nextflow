/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run bifrost.nf -c conf/test.config

----------------------------------------------------------------------------------------
*/

params {
    n_cores = 2
    max_nodes = 1

    // Input data
    input = "${projectDir}/assets/test_data/minimal/Example_Meta_Data.csv"
    counts = "${projectDir}/assets/test_data/minimal/Example_Counts_2probes.csv"
    substances_cell_types = "${projectDir}/assets/test_data/minimal/substances_cell_types.yml"
}